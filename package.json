{
  "name": "quest-phone-stream",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:signaling": "pnpm --dir apps/signaling-server dev",
    "test:signaling": "pnpm --dir apps/signaling-server test",
    "build:signaling": "pnpm --dir apps/signaling-server build",
    "check:spatial": "node scripts/check-spatial-protocol.mjs",
    "check:p1p2": "node scripts/check-p1-p2-closeout.mjs",
    "check:p3": "node scripts/check-p3-spatial.mjs && node scripts/check-p3-lifecycle.mjs && node scripts/check-device-select-connect.mjs",
    "check:p3-regressions": "node scripts/check-p3-regressions.mjs",
    "check:p3-lifecycle": "node scripts/check-p3-lifecycle.mjs",
    "check:device-select": "node scripts/check-device-select-connect.mjs"
  },
  "packageManager": "pnpm@9.12.0"
}
