{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://questphonestream.local/protocol/spatial/device.schema.json",
  "title": "Spatial Device Descriptor",
  "type": "object",
  "required": ["id", "name", "protocolVersions"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "protocolVersions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
