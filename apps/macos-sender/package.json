{
  "name": "questphonestream-macos-sender",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && esbuild src/renderer.ts --bundle --format=iife --platform=browser --outfile=dist/renderer.js && esbuild src/aiVideoBootstrap.ts --bundle --format=iife --platform=browser --outfile=dist/ai-video-bootstrap.js && node -e \"require('fs').copyFileSync('src/index.html','dist/index.html')\"",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.questphonestream.macos-sender",
    "productName": "QuestPhoneStream Mac",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "QuestPhoneStream Mac ${version}"
    }
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
